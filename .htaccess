# Mohika Invisible Grills & Safety Nets — Apache (shared hosting, e.g. Hostinger)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # https + non-www in ONE hop. HTTPS is detected two ways because hosts
    # that terminate TLS at a proxy read %{HTTPS} as off behind it.
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Right scheme, wrong host.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Dot-paths (.git above all) — except .well-known for SSL validation.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # Repo documentation and internal folders are never served.
    RewriteRule ^(README\.md|DEPLOY\.md|KEYWORDS\.md)$ - [F,L]
    RewriteRule ^(config|core|data|partials|templates|tools|source-images|source-videos|node_modules)(/|$) - [F,L]

    # Real files (assets, favicon, manifest, the form handler) are served
    # as they are; /index.php is a real file too — the router 301s it to /.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else — the .php pages and .html city pages included — is
    # rendered by the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes
<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Pages are rendered per request; assets are fingerprinted (?v=mtime).
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|ico|woff2|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

AddType application/manifest+json .webmanifest
AddType video/mp4 .mp4
